//@version=5
indicator("Weekday Setups", overlay=true, max_labels_count=500, max_lines_count=500)

// Tue = high breakouts | Wed = trend continuation | Thu = reversals | Fri = reversals + fake-outs
// Any day (optional) = trend shift on moving average crossover
g1 = "Setups"
lookback = input.int(20, "Breakout / range lookback", minval=5, group=g1)
fastLen  = input.int(10, "Fast SMA", minval=2, group=g1)
slowLen  = input.int(30, "Slow SMA", minval=3, group=g1)
revLook  = input.int(10, "Reversal prior-move lookback", minval=2, group=g1)
useCross = input.bool(true, "Trend-shift entries on MA crossover (all days)", group=g1)

g2 = "Risk"
rr       = input.float(2.0, "Reward : Risk", minval=0.5, step=0.5, group=g2)
atrMult  = input.float(0.25, "Stop buffer (x ATR)", minval=0.0, step=0.05, group=g2)

g3 = "Display"
showLvls  = input.bool(false, "Draw SL / TP lines", group=g3)
showDet   = input.bool(false, "Show entry/SL/TP text on label (otherwise in hover tooltip)", group=g3)
showSeps  = input.bool(true, "Day separators + headers", group=g3)
showShift = input.bool(true, "Shade MA ribbon", group=g3)
sepColor  = input.color(color.new(color.gray, 80), "Separator colour", group=g3)

atrV = ta.atr(14)
dow  = dayofweek(time, syminfo.timezone)
isTue = dow == dayofweek.tuesday
isWed = dow == dayofweek.wednesday
isThu = dow == dayofweek.thursday
isFri = dow == dayofweek.friday

hi = ta.highest(high, lookback)[1]
lo = ta.lowest(low, lookback)[1]
f  = ta.sma(close, fastLen)
s  = ta.sma(close, slowLen)

// Tuesday: breakout
brkBuy  = isTue and close > hi
brkSell = isTue and close < lo

// Wednesday: trend continuation (pullback to fast SMA)
contBuy  = isWed and f > s and low[1] <= f and close > f and close > open
contSell = isWed and f < s and high[1] >= f and close < f and close < open

// Thursday + Friday: engulfing reversal against prior move
move = close[1] - close[revLook + 1]
revBuy  = (isThu or isFri) and move < 0 and close[1] < open[1] and close > open[1] and open <= close[1]
revSell = (isThu or isFri) and move > 0 and close[1] > open[1] and close < open[1] and open >= close[1]

// Friday: fake-out (failed break, closes back inside range)
fakeSell = isFri and high > hi and close < hi
fakeBuy  = isFri and low  < lo and close > lo

// Any day: trend shift = MA crossover
shiftBuy  = useCross and ta.crossover(f, s)
shiftSell = useCross and ta.crossunder(f, s)

buySig  = brkBuy or contBuy or revBuy or fakeBuy or shiftBuy
sellSig = brkSell or contSell or revSell or fakeSell or shiftSell

// Stops beyond signal candle (and prior candle for 2-bar patterns)
twoBarBuy  = contBuy or revBuy
twoBarSell = contSell or revSell
buyStop  = (twoBarBuy ? math.min(low, low[1]) : low) - atrMult * atrV
sellStop = (twoBarSell ? math.max(high, high[1]) : high) + atrMult * atrV

setupName(b, c, r, k, x) => b ? "Breakout" : c ? "Trend" : r ? "Reversal" : k ? "Fake-out" : x ? "Trend shift" : ""

buyName  = setupName(brkBuy, contBuy, revBuy, fakeBuy, shiftBuy)
sellName = setupName(brkSell, contSell, revSell, fakeSell, shiftSell)

if buySig and barstate.isconfirmed
    tp = close + rr * (close - buyStop)
    lvls = "Entry " + str.tostring(close, format.mintick) + "\nSL " + str.tostring(buyStop, format.mintick) + "\nTP " + str.tostring(tp, format.mintick)
    label.new(bar_index, low, "BUY " + buyName + (showDet ? "\n" + lvls : ""), style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.tiny, tooltip=lvls)
    if showLvls
        line.new(bar_index, buyStop, bar_index + 8, buyStop, color=color.new(color.red, 30), style=line.style_dotted)
        line.new(bar_index, tp, bar_index + 8, tp, color=color.new(color.green, 30), style=line.style_dotted)

if sellSig and barstate.isconfirmed
    tp = close - rr * (sellStop - close)
    lvls = "Entry " + str.tostring(close, format.mintick) + "\nSL " + str.tostring(sellStop, format.mintick) + "\nTP " + str.tostring(tp, format.mintick)
    label.new(bar_index, high, "SELL " + sellName + (showDet ? "\n" + lvls : ""), style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny, tooltip=lvls)
    if showLvls
        line.new(bar_index, sellStop, bar_index + 8, sellStop, color=color.new(color.red, 30), style=line.style_dotted)
        line.new(bar_index, tp, bar_index + 8, tp, color=color.new(color.green, 30), style=line.style_dotted)

// ---- Day separators with small header (title + what is expected) ----
newDay = timeframe.isintraday and ta.change(time("D")) != 0
dayTitle = switch dow
    dayofweek.monday => "MON - range building"
    dayofweek.tuesday => "TUE - high breakouts"
    dayofweek.wednesday => "WED - trend continuation"
    dayofweek.thursday => "THU - reversals"
    dayofweek.friday => "FRI - reversals + fake-outs"
    => "WEEKEND"
dayColor = switch dow
    dayofweek.tuesday => color.green
    dayofweek.wednesday => color.blue
    dayofweek.thursday => color.orange
    dayofweek.friday => color.red
    => color.gray

if showSeps and newDay
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=sepColor, style=line.style_dotted)
    label.new(bar_index, high + 3 * atrV, dayTitle, style=label.style_label_left, color=color.new(dayColor, 35), textcolor=color.white, size=size.tiny)

// ---- Moving averages: green in uptrend, red in downtrend ----
maColor = f > s ? color.green : f < s ? color.red : color.gray
pf = plot(f, "Fast SMA", maColor, 2)
ps = plot(s, "Slow SMA", color.new(maColor, 40), 1)
fill(pf, ps, showShift ? color.new(maColor, 90) : na)

alertcondition(buySig,  "Buy setup",  "Weekday setup BUY on {{ticker}} @ {{close}}")
alertcondition(sellSig, "Sell setup", "Weekday setup SELL on {{ticker}} @ {{close}}")
alertcondition(shiftBuy,  "Trend shift up",   "Trend shift UP on {{ticker}} @ {{close}}")
alertcondition(shiftSell, "Trend shift down", "Trend shift DOWN on {{ticker}} @ {{close}}")
